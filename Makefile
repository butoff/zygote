# This is a makefile for building Android applications using only and
# exclusively make(1) as a buildsystem.

# Normally, you don't need to edit this file. All the configurable properties
# are located in the following included part:
include config.mk

# SDK paths and tools. Values are derived from the previously defined variables.

PLATFORM_PATH := $(ANDROID_HOME)/platforms/android-$(PLATFORM_VERSION)
ANDROID_JAR := $(PLATFORM_PATH)/android.jar

BUILD_TOOLS_PATH := $(ANDROID_HOME)/build-tools/$(BUILD_TOOLS_VERSION)
AAPT := $(BUILD_TOOLS_PATH)/aapt
D8 := $(BUILD_TOOLS_PATH)/d8
ZIPALIGN := $(BUILD_TOOLS_PATH)/zipalign
APKSIGNER := $(BUILD_TOOLS_PATH)/apksigner
AIDL := $(BUILD_TOOLS_PATH)/aidl

PLATFORM_TOOLS_PATH := $(ANDROID_HOME)/platform-tools
ADB := $(PLATFORM_TOOLS_PATH)/adb

# Intermediate apk files
APK_DIR := $(OUT_DIR)/apk
UNALIGNED_APK := $(APK_DIR)/unaligned.apk
UNSIGNED_APK := $(APK_DIR)/unsigned.apk
SIGNED_APK := $(OUT_DIR)/signed.apk

# *.class and *.dex related variables
CLASSES_DIR := $(OUT_DIR)/classes
DEX_DIR := $(OUT_DIR)/dex
DEX := $(DEX_DIR)/classes.dex

# Generated files location
GEN_DIR := $(OUT_DIR)/generated

# package name as a path, e.g. my.package -> my/package
PACKAGE_PATH := $(subst .,/,$(PACKAGE_NAME))

# R.java generated file
R_FILE := $(GEN_DIR)/$(PACKAGE_PATH)/R.java

# java compiler and its command line arguments
JAVAC := javac
JAVAC_ARGS := -sourcepath $(SRC_DIR) -d $(CLASSES_DIR) -classpath $(ANDROID_JAR)

RES_SOURCES := $(shell find $(RES_DIR) -name '*.xml')

JAVA_SOURCES := $(shell find $(SRC_DIR) -name '*.java')

aidls_tmp := $(if $(AIDL_DIR),$(shell find $(AIDL_DIR) -name '*.aidl' -printf %P))

AIDL_SOURCES := $(addprefix $(AIDL_DIR)/,$(aidls_tmp))

# java files generated by aidl tool
STUB_FILES := $(patsubst %.aidl,%.java,$(addprefix $(GEN_DIR)/,$(aidls_tmp)))

# A list of *.class files
JAVA_CLASSES := $(OUT_DIR)/JAVA_CLASSES

################################################################################

# TODO: write brief but explanatory help message, print variables
.PHONY: help
help:
	@echo Targets: build install run etc

.PHONY: build
build: $(SIGNED_APK)

$(R_FILE): $(RES_SOURCES)
	mkdir -p $(GEN_DIR)
	$(AAPT) package -f -M $(MANIFEST) -S $(RES_DIR) -J $(GEN_DIR) -m -I $(ANDROID_JAR)

$(STUB_FILES): $(AIDL_SOURCES)
	$(AIDL) -I $(AIDL_DIR) -o $(GEN_DIR) $^

.PHONY: compile
compile: $(JAVA_CLASSES)

$(JAVA_CLASSES): $(JAVA_SOURCES) $(R_FILE) $(STUB_FILES)
	mkdir -p $(CLASSES_DIR)
	$(JAVAC) $(JAVAC_ARGS) $^
	find $(CLASSES_DIR) -name '*.class' > $@

$(DEX): compile
	mkdir -p $(DEX_DIR)
	$(D8) --output $(DEX_DIR) @$(JAVA_CLASSES)

$(UNALIGNED_APK): $(DEX) $(MANIFEST) $(RES_SOURCES)
	mkdir -p $(APK_DIR)
	$(AAPT) package -f -M $(MANIFEST) -S $(RES_DIR) -I $(ANDROID_JAR) -F $@ $(DEX_DIR)

$(UNSIGNED_APK): $(UNALIGNED_APK)
	$(ZIPALIGN) -f -v 4 -p $< $@

$(SIGNED_APK): $(UNSIGNED_APK)
	$(APKSIGNER) sign --ks $(KS) --ks-pass pass:$(KS_PASS) --in $< --out $@

.PHONY: install
install: $(SIGNED_APK)
	$(ADB) install $<

.PHONY: uninstall
uninstall:
	$(ADB) uninstall $(PACKAGE_NAME)

# TODO: dependency from install!
.PHONY: run
run: #install
	$(ADB) shell am start $(PACKAGE_NAME)

# TODO: dependency from uninstall?
.PHONY: clean
clean: #uninstall
	rm -rf $(OUT_DIR)
